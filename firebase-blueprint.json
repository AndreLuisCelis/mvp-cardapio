{
  "entities": {
    "MenuItem": {
      "title": "MenuItem",
      "description": "Item do cardápio da hamburgueria Artisanal Ember.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Nome do produto no cardápio."
        },
        "category": {
          "type": "string",
          "enum": ["burgers", "combos", "sides", "drinks"],
          "description": "Categoria do item no cardápio."
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500,
          "description": "Descrição completa do prato."
        },
        "ingredientsSummary": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "description": "Resumo curto de ingredientes separado por pontos."
        },
        "price": {
          "type": "number",
          "description": "Preço unitário em reais (BRL)."
        },
        "calories": {
          "type": "number",
          "description": "Valor energético aproximado em kcal."
        },
        "prepMinutes": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "description": "Tempo estimado de preparo."
        },
        "rating": {
          "type": "number",
          "description": "Nota média de avaliação (0 a 5)."
        },
        "reviewCount": {
          "type": "number",
          "description": "Quantidade de avaliações."
        },
        "dietaryNote": {
          "type": "string",
          "maxLength": 60,
          "description": "Nota curta opcional (ex: Vegetariano, Assinatura da casa)."
        },
        "featured": {
          "type": "boolean",
          "description": "Indica se o item aparece em Destaques do Chef."
        },
        "isHero": {
          "type": "boolean",
          "description": "Indica se o item é o destaque principal da vitrine."
        },
        "published": {
          "type": "boolean",
          "description": "Define se o item está visível e disponível no cardápio."
        },
        "imageKey": {
          "type": "string",
          "enum": [
            "hero_smash",
            "truffle_brisket",
            "spicy_chicken",
            "classic_ember",
            "rosemary_fries",
            "craft_soda"
          ],
          "description": "Chave da fotografia culinária associada ao item."
        },
        "customizationGroupKeys": {
          "type": "array",
          "description": "Lista limitada (máx 5) de chaves de personalização."
        },
        "sortOrder": {
          "type": "number",
          "description": "Ordem de exibição no cardápio."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação no servidor."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização no servidor."
        }
      },
      "required": [
        "name",
        "category",
        "description",
        "ingredientsSummary",
        "price",
        "calories",
        "prepMinutes",
        "rating",
        "reviewCount",
        "featured",
        "isHero",
        "published",
        "imageKey",
        "customizationGroupKeys",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "Comanda de pedido da cozinha sem dados pessoais (dados do comprador ficam exclusivamente no localStorage).",
      "type": "object",
      "properties": {
        "orderCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "pattern": "^[A-Z0-9\\-]+$",
          "description": "Código legível do pedido (ex: EB-1043)."
        },
        "fulfillment": {
          "type": "string",
          "enum": ["pickup", "delivery"],
          "description": "Modalidade de recebimento."
        },
        "pickupWindow": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "description": "Janela estimada de retirada ou entrega."
        },
        "subtotal": {
          "type": "number",
          "description": "Subtotal dos itens em BRL."
        },
        "deliveryFee": {
          "type": "number",
          "description": "Taxa de entrega em BRL."
        },
        "tip": {
          "type": "number",
          "description": "Gorjeta em BRL."
        },
        "total": {
          "type": "number",
          "description": "Total final do pedido em BRL."
        },
        "stage": {
          "type": "number",
          "description": "Etapa da cozinha: 0 confirmado, 1 grelha, 2 montagem, 3 pronto."
        },
        "estimatedReady": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20,
          "description": "Horário previsto de conclusão."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação no servidor."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização no servidor."
        }
      },
      "required": [
        "orderCode",
        "fulfillment",
        "pickupWindow",
        "subtotal",
        "deliveryFee",
        "tip",
        "total",
        "stage",
        "estimatedReady",
        "createdAt",
        "updatedAt"
      ]
    },
    "OrderItem": {
      "title": "OrderItem",
      "description": "Item individual de um pedido armazenado em subcoleção.",
      "type": "object",
      "properties": {
        "menuItemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "ID do item do cardápio."
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Nome do item no momento da compra."
        },
        "quantity": {
          "type": "number",
          "description": "Quantidade comprada (1 a 20)."
        },
        "summary": {
          "type": "string",
          "maxLength": 400,
          "description": "Resumo de personalizações e observações."
        },
        "lineTotal": {
          "type": "number",
          "description": "Valor total da linha em BRL."
        }
      },
      "required": ["menuItemId", "name", "quantity", "summary", "lineTotal"]
    }
  },
  "firestore": {
    "/menu_items/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Catálogo persistente do cardápio da hamburgueria."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Comandas de pedido sem PII (acesso apenas por ID direto salvo no localStorage)."
    },
    "/orders/{orderId}/items/{itemId}": {
      "schema": { "$ref": "#/entities/OrderItem" },
      "description": "Itens detalhados pertencentes a cada comanda."
    }
  }
}
