{
  "entities": {
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Configurações gerais da loja, marca, logo, banner e textos da vitrine.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Nome do estabelecimento."
        },
        "neighborhood": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Bairro principal da loja."
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Cidade e estado."
        },
        "minOrder": {
          "type": "number",
          "description": "Valor mínimo do pedido para entrega em BRL."
        },
        "deliveryFee": {
          "type": "number",
          "description": "Taxa padrão de entrega em BRL."
        },
        "deliveryTimeMin": {
          "type": "string",
          "minLength": 2,
          "maxLength": 30,
          "description": "Tempo estimado de entrega (ex: 20-30)."
        },
        "whatsappNumber": {
          "type": "string",
          "minLength": 8,
          "maxLength": 25,
          "pattern": "^[0-9]+$",
          "description": "Número WhatsApp da loja com DDI e DDD (apenas dígitos)."
        },
        "orderCodePrefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "pattern": "^[A-Z0-9]+$",
          "description": "Prefixo do código de pedidos."
        },
        "pickupEstimatedMinutes": {
          "type": "number",
          "description": "Tempo estimado para retirada em minutos."
        },
        "deliveryEstimatedMinutes": {
          "type": "number",
          "description": "Tempo estimado para entrega em minutos."
        },
        "aboutNavLabel": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "description": "Rótulo da aba Institucional/Sobre."
        },
        "heroHeadline": {
          "type": "string",
          "minLength": 4,
          "maxLength": 160,
          "description": "Título principal do destaque na home."
        },
        "searchPlaceholder": {
          "type": "string",
          "minLength": 4,
          "maxLength": 140,
          "description": "Placeholder do campo de busca do cardápio."
        },
        "emptyBagDescription": {
          "type": "string",
          "minLength": 4,
          "maxLength": 300,
          "description": "Mensagem exibida quando a sacola está vazia."
        },
        "paymentMethodsLabel": {
          "type": "string",
          "minLength": 4,
          "maxLength": 200,
          "description": "Texto informativo de formas de pagamento."
        },
        "logoUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 350000,
          "description": "URL ou imagem base64 otimizada da logo do estabelecimento."
        },
        "bannerUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 350000,
          "description": "URL ou imagem base64 otimizada do banner da página Sobre."
        },
        "aboutHeadline": {
          "type": "string",
          "minLength": 4,
          "maxLength": 180,
          "description": "Título principal da seção Sobre."
        },
        "aboutDescription": {
          "type": "string",
          "minLength": 4,
          "maxLength": 600,
          "description": "Descrição institucional da lanchonete."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização no servidor."
        }
      },
      "required": [
        "name",
        "neighborhood",
        "city",
        "minOrder",
        "deliveryFee",
        "deliveryTimeMin",
        "whatsappNumber",
        "orderCodePrefix",
        "pickupEstimatedMinutes",
        "deliveryEstimatedMinutes",
        "aboutNavLabel",
        "heroHeadline",
        "searchPlaceholder",
        "emptyBagDescription",
        "paymentMethodsLabel",
        "logoUrl",
        "bannerUrl",
        "aboutHeadline",
        "aboutDescription",
        "updatedAt"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Categoria dinâmica do cardápio.",
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9\\-]+$",
          "description": "Slug identificador da categoria."
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Título exibido no cardápio."
        },
        "isCombo": {
          "type": "boolean",
          "description": "Indica se a categoria pertence à aba de Combos."
        },
        "active": {
          "type": "boolean",
          "description": "Define se a categoria está ativa no cardápio público."
        },
        "sortOrder": {
          "type": "number",
          "description": "Ordem de exibição da categoria."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação no servidor."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização no servidor."
        }
      },
      "required": ["key", "title", "isCombo", "active", "sortOrder", "createdAt", "updatedAt"]
    },
    "DeliveryFee": {
      "title": "DeliveryFee",
      "description": "Opção de taxa de entrega por bairro/região ou retirada.",
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Descrição do bairro ou modalidade."
        },
        "fee": {
          "type": "number",
          "description": "Valor da taxa em BRL."
        },
        "fulfillment": {
          "type": "string",
          "enum": ["delivery", "pickup"],
          "description": "Tipo de atendimento (entrega ou retirada)."
        },
        "active": {
          "type": "boolean",
          "description": "Define se a taxa está habilitada no checkout."
        },
        "sortOrder": {
          "type": "number",
          "description": "Ordem de exibição."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação no servidor."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização no servidor."
        }
      },
      "required": ["label", "fee", "fulfillment", "active", "sortOrder", "createdAt", "updatedAt"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Item do cardápio digital.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Nome do produto no cardápio."
        },
        "category": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9\\-]+$",
          "description": "Slug da categoria do item no cardápio."
        },
        "categoryLabel": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Nome legível da categoria."
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500,
          "description": "Descrição completa do item."
        },
        "ingredientsSummary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200,
          "description": "Resumo curto de ingredientes."
        },
        "price": {
          "type": "number",
          "description": "Preço unitário atual em BRL."
        },
        "originalPrice": {
          "type": "number",
          "description": "Preço original antes da promoção (0 ou ausente se não houver)."
        },
        "prepMinutes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "Tempo estimado de preparo."
        },
        "rating": {
          "type": "number",
          "description": "Nota média de avaliação (0 a 5)."
        },
        "reviewCount": {
          "type": "number",
          "description": "Quantidade de avaliações."
        },
        "dietaryNote": {
          "type": "string",
          "maxLength": 60,
          "description": "Etiqueta curta opcional (ex: Oferta, Promoção)."
        },
        "featured": {
          "type": "boolean",
          "description": "Indica se o item aparece em Ofertas em Destaque."
        },
        "isHero": {
          "type": "boolean",
          "description": "Indica se o item é o destaque principal da vitrine."
        },
        "published": {
          "type": "boolean",
          "description": "Define se o item está visível e disponível no cardápio."
        },
        "imageKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Chave de fallback da imagem associada."
        },
        "imageUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 350000,
          "description": "URL, caminho local ou imagem base64 otimizada do item."
        },
        "customizationGroupKeys": {
          "type": "array",
          "description": "Lista limitada (máx 5) de chaves de personalização."
        },
        "sortOrder": {
          "type": "number",
          "description": "Ordem de exibição no cardápio."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação no servidor."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização no servidor."
        }
      },
      "required": [
        "name",
        "category",
        "categoryLabel",
        "description",
        "ingredientsSummary",
        "price",
        "prepMinutes",
        "rating",
        "reviewCount",
        "featured",
        "isHero",
        "published",
        "imageKey",
        "imageUrl",
        "customizationGroupKeys",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "StaffUser": {
      "title": "StaffUser",
      "description": "Usuário autorizado a operar o painel administrativo e seu nível de permissão.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID do usuário no Firebase Authentication."
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "description": "E-mail de login do usuário."
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Nome de exibição no painel."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "editor"],
          "description": "Papel do usuário no painel."
        },
        "canManageUsers": {
          "type": "boolean",
          "description": "Permite adicionar, editar e gerenciar outros usuários."
        },
        "active": {
          "type": "boolean",
          "description": "Define se o acesso ao painel está ativo."
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID do administrador que criou o usuário."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação no servidor."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização no servidor."
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "role",
        "canManageUsers",
        "active",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "Comanda de pedido da cozinha sem dados pessoais (dados do comprador ficam exclusivamente no localStorage).",
      "type": "object",
      "properties": {
        "orderCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "pattern": "^[A-Z0-9\\-]+$",
          "description": "Código legível do pedido."
        },
        "fulfillment": {
          "type": "string",
          "enum": ["pickup", "delivery"],
          "description": "Modalidade de recebimento."
        },
        "pickupWindow": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "description": "Janela estimada de retirada ou entrega."
        },
        "subtotal": {
          "type": "number",
          "description": "Subtotal dos itens em BRL."
        },
        "deliveryFee": {
          "type": "number",
          "description": "Taxa de entrega em BRL."
        },
        "tip": {
          "type": "number",
          "description": "Gorjeta em BRL."
        },
        "total": {
          "type": "number",
          "description": "Total final do pedido em BRL."
        },
        "stage": {
          "type": "number",
          "description": "Etapa da cozinha: 0 confirmado, 1 na chapa, 2 montagem, 3 pronto."
        },
        "estimatedReady": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20,
          "description": "Horário previsto de conclusão."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação no servidor."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última atualização no servidor."
        }
      },
      "required": [
        "orderCode",
        "fulfillment",
        "pickupWindow",
        "subtotal",
        "deliveryFee",
        "tip",
        "total",
        "stage",
        "estimatedReady",
        "createdAt",
        "updatedAt"
      ]
    },
    "OrderItem": {
      "title": "OrderItem",
      "description": "Item individual de um pedido armazenado em subcoleção.",
      "type": "object",
      "properties": {
        "menuItemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "ID do item do cardápio."
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Nome do item no momento da compra."
        },
        "quantity": {
          "type": "number",
          "description": "Quantidade comprada (1 a 20)."
        },
        "summary": {
          "type": "string",
          "maxLength": 400,
          "description": "Resumo de personalizações e observações."
        },
        "lineTotal": {
          "type": "number",
          "description": "Valor total da linha em BRL."
        }
      },
      "required": ["menuItemId", "name", "quantity", "summary", "lineTotal"]
    }
  },
  "firestore": {
    "/store_settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Configurações globais da loja, logo, banner e textos públicos."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Categorias dinâmicas do cardápio."
    },
    "/delivery_fees/{feeId}": {
      "schema": { "$ref": "#/entities/DeliveryFee" },
      "description": "Taxas de entrega por bairro e retirada no balcão."
    },
    "/menu_items/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Catálogo persistente de itens do cardápio."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/StaffUser" },
      "description": "Usuários administrativos e permissões RBAC (canManageUsers)."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Comandas de pedido sem PII."
    },
    "/orders/{orderId}/items/{itemId}": {
      "schema": { "$ref": "#/entities/OrderItem" },
      "description": "Itens detalhados pertencentes a cada comanda."
    }
  }
}
